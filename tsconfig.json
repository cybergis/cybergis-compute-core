{
    "compilerOptions": {
        "target": "ES2022",
        "module": "es2022",
        "declaration": false,
        "strict": true,
        "noImplicitAny": true,
        "noLib": false,
        "outDir": "production",
        "skipLibCheck": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "resolveJsonModule": true,
        "strictNullChecks": true,
        "esModuleInterop": true,
        "moduleResolution": "node",
        "sourceMap": true,
    },
    "include": [
        "**/*.ts",
    ],
    "exclude": [
        "node_modules",
        "**/*.spec.ts",
        "temp.*",
        "production/*"
    ]
}